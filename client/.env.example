# Public Firebase Web SDK configuration (safe to expose in browser)
# NEVER put GEMINI_API_KEY, WAQI_API_TOKEN, or server secrets here.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Firebase Cloud Functions region for httpsCallable (`onCall`) endpoints
VITE_FUNCTIONS_REGION=asia-south1

# Set to true only when running against local Firebase Emulators
VITE_USE_EMULATORS=false
